# Optional load balancer template. Edit server addresses for your deployment.
# This file is not installed or activated by docker-compose.yml.
events {}

http {
    upstream course_ai_backend {
        least_conn;
        server 127.0.0.1:8001;
        server 127.0.0.1:8002;
    }

    server {
        listen 8080;

        location /api/ {
            proxy_pass http://course_ai_backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 150s;
        }

        location /health {
            proxy_pass http://course_ai_backend;
        }
    }
}
