# APP
APP_NAME=Course AI
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# POSTGRESQL
# Credentials are intentionally empty. Fill them yourself.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# REDIS
# For the local Compose template: redis://localhost:6379/0
REDIS_URL=

# RATE LIMIT
RATE_LIMIT_PER_MINUTE=10

# LLM (OpenAI-compatible chat completion API)
LLM_BASE_URL=https://api.deepseek.com
LLM_CHAT_PATH=/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=90
LLM_MAX_CONCURRENCY=50
LLM_QUEUE_WAIT_SECONDS=15
LLM_LEASE_SECONDS=120
LLM_MAX_RETRIES=2

# RAG
RAG_ENABLED=false
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_PATH=/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
RAG_TOP_K=5
CACHE_TTL_SECONDS=3600
